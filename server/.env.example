# MongoDB connection string
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ticket_platform"

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-string"

# Port
PORT=4000

# Frontend origin for CORS. Comma-separated if you have multiple URLs
# (e.g. production + Vercel preview deployments).
CLIENT_ORIGIN="http://localhost:5173"

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys
# Webhook secret → Settings → Webhooks (point to /api/public/payments/webhook)
RAZORPAY_KEY_ID="your-key-id"
RAZORPAY_KEY_SECRET="your-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get a free key at resend.com/api-keys (3,000 emails/month free)
# MAIL_FROM_EMAIL: must be on a domain verified in your Resend dashboard.
#   Leave unset to use onboarding@resend.dev (Resend's shared test address —
#   fine for testing, use your own domain for production).
RESEND_API_KEY="re_your_api_key"
MAIL_FROM_EMAIL="tickets@yourdomain.com"
MAIL_FROM_NAME="Marquee"

CONTACT_SUPPORT_EMAIL=
NODE_ENV=development
